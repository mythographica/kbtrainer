{
  "compilerOptions": {
    "target": "ES2020",
    "module": "es2015",
    "lib": ["ES2020", "DOM"],
    "outDir": "app/bin",
    "rootDir": "src/renderer",
    "strict": true,
    "noCheck": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/renderer/**/*.ts"],
  "exclude": ["src/renderer/store.ts"]
}
