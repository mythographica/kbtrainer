{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "lib": ["ES2021"],
    "outDir": "dist/models",
    "rootDir": "models",
    "strict": true,
    "noCheck": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "sourceMap": false,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["models/**/*.ts", "models/**/*.js"]
}
